# PayPal Configuration
PAYPAL_RECEIVER_EMAIL=knightmyself@live.com
PAYPAL_ME_USERNAME=knightmyself
PAYPAL_DAILY_TARGET_USD=500

# Groq LLM (Llama 3.3 70B for Senior Architect negotiation)
# Sign up at https://console.groq.com to get a free API key, or leave blank for offline mock mode
GROQ_API_KEY=

# Local Data Vault Security (AES-256)
# If left blank, an encryption key will be automatically generated and persisted in data/vault.key
AES_ENCRYPTION_KEY=

# Email / Gmail Integration (Optional - human approval required for every send)
GMAIL_SENDER_EMAIL=knightmyself@live.com
GMAIL_APP_PASSWORD=

# Privacy & Telemetry Flag (Strictly 0: No Telemetry, No External Tracking)
ZERO_TELEMETRY=1
LOCAL_ONLY=1
